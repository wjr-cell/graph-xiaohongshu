# Database Configuration
# PostgreSQL 连接字符串 (用于 SQLAlchemy AsyncIO)
DATABASE_URL=postgresql+asyncpg://postgres:123456@localhost:5432/langgraph_db

# PostgreSQL 连接字符串 (用于 psycopg3 / LangGraph Checkpointer)
POSTGRES_URI=postgresql://postgres:123456@localhost:5432/langgraph_db

# Application Settings
APP_NAME=AI内容运营助手
DEBUG=true

# LLM Configuration (火山引擎 Doubao)
# 在此填写你的API Key
LLM_API_KEY=your_ark_api_key
LLM_BASE_URL=https://ark.cn-beijing.volces.com/api/v3

# 标准模型 (文章写作用，需要高质量输出)
LLM_MODEL=doubao-seed-2-1-pro-260915
LLM_TEMPERATURE=0.7

# 快速模型 (选题生成、配图要点提取用，追求速度)
LLM_MODEL_FAST=doubao-seed-2-0-mini-260428
LLM_TEMPERATURE_FAST=0.7
LLM_TEMPERATURE_EXTRACT=0.4

# LangSmith 配置 (追踪与监控)
# 启用 LangSmith 追踪
LANGCHAIN_TRACING_V2=true
# 你的 LangSmith API Key（请替换为你的实际 key）
LANGCHAIN_API_KEY=your_langsmith_api_key
# 项目名称（在 LangSmith 中显示）
LANGCHAIN_PROJECT=xiaohongshu-content-assistant
# LangSmith 端点（官方默认端点）
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com

# ============== 日志配置 ==============
# 日志级别: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# 日志输出目标: file, loki, aliyun, volcengine
# 目前支持 file，后续可扩展云服务
LOG_TARGET=file

# 日志文件目录
LOG_DIR=logs

# 是否在控制台输出日志（开发时建议 true）
LOG_CONSOLE=false

# 控制台是否输出 JSON 格式（false 则彩色输出，开发友好）
LOG_JSON=false

# 是否启用 PII 脱敏（邮箱、信用卡、API Key、手机号）
LOG_PII_ANONYMIZE=true

# ============== 图片生成配置 (火山方舟 Seedream) ==============
# 方舟 API Key
IMAGE_API_KEY=your_ark_api_key
# API 基础地址
IMAGE_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
# 图片生成模型
IMAGE_MODEL=doubao-seedream-5-0-flash-260915
# 3:4 竖版，对应 Seedream 5.0 flash 的 1.5K
IMAGE_SIZE=1344x1792
